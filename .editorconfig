root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[go.{mod,sum}]
indent_style = tab

[*.sql]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 4

[*.sh]
indent_size = 4

[Caddyfile]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{html,css,js,ts}]
indent_size = 2
